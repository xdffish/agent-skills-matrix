{
  "name": "agent-skills-matrix",
  "displayName": "Agent Skills Matrix",
  "description": "Multi-agent skill matrix dashboard and dispatcher powered by standard npx skills",
  "version": "0.5.6",
  "publisher": "defuxu",
  "author": {
    "name": "defuxu"
  },
  "license": "MIT",
  "homepage": "https://github.com/xdffish/agent-skills-matrix#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/xdffish/agent-skills-matrix.git"
  },
  "bugs": {
    "url": "https://github.com/xdffish/agent-skills-matrix/issues"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "agent",
    "skills",
    "antigravity",
    "codex",
    "cursor",
    "claude-code",
    "matrix",
    "tools"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:agent-skills-matrix.view"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-skills-matrix-container",
          "title": "Skills Matrix",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agent-skills-matrix-container": [
        {
          "type": "webview",
          "id": "agent-skills-matrix.view",
          "name": "Matrix Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "agent-skills-matrix.refresh",
        "title": "Refresh Skills Matrix",
        "category": "Skills Matrix",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-skills-matrix.open",
        "title": "Open Skills Matrix Dashboard",
        "category": "Skills Matrix"
      },
      {
        "command": "agent-skills-matrix.openPanel",
        "title": "Open Skills Matrix in Editor Area",
        "category": "Skills Matrix",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agent-skills-matrix.refresh",
          "when": "view == agent-skills-matrix.view",
          "group": "navigation"
        },
        {
          "command": "agent-skills-matrix.openPanel",
          "when": "view == agent-skills-matrix.view",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "type-check": "tsc --noEmit",
    "test:cli": "node dist/test-cli.js",
    "vsce:package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
